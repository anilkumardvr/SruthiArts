
@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Sruthi Arts";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/transitions.css" asp-append-version="true" />

    <style>
        /* Minimal dark aesthetic to match your vibe */
        html,body{background:#0b0b0f;color:#e9e9f0;font-family:ui-sans-serif,system-ui,Segoe UI,Roboto,Arial,sans-serif}
        a{color:#c8b6ff;text-decoration:none}
        a:hover{text-decoration:underline}
        header{position:sticky;top:0;z-index:50;background:linear-gradient(180deg,#0b0b0f 0%, rgba(11,11,15,0.6) 100%);backdrop-filter:blur(6px);border-bottom:1px solid rgba(255,255,255,.06)}
        .wrap{max-width:1100px;margin:0 auto;padding:20px}
        .brand{font-weight:800;letter-spacing:.04em}
    </style>
</head>
<body>
    <header>
        <div class="wrap">
            <a class="brand" href="/">Sruthi Arts</a>
        </div>
    </header>

    <!-- Transition root wraps the body content -->
    <main id="transition-root" class="page-transition">
        <div class="wrap">
            @RenderBody()
        </div>
    </main>

    <script src="~/js/transitions.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>