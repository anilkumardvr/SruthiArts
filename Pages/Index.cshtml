@page
@model SruthiArts.Pages.IndexModel
@{
    ViewData["Title"] = "Featured Paintings";
}
<section class="container">
    <h1>Featured Paintings</h1>
    <p>Welcome to Sruthi Arts – explore my aesthetic paintings!</p>

    @if (Model.Paintings.Count == 0)
    {
        <div class="empty">No paintings yet. (DB not seeded?)</div>
    }
    else
    {
        <div class="grid">
        @foreach (var p in Model.Paintings)
        {
            <a class="card zoom-enter" href="/Paintings/Details?id=@p.Id">
                <img src="@p.ImageUrl" alt="@p.Title" loading="lazy" />
                <div class="meta">
                    <h3>@p.Title</h3>
                    <p>@p.Description</p>
                    <div class="price">$@p.Price</div>
                </div>
            </a>
        }
        </div>
    }
</section>

<link rel="stylesheet" href="~/css/site.css" />
<script src="~/js/fairy.js"></script>
